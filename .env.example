# ============================================================
# AYCHO 统一后端网关配置（复制本文件为 .env 后填写真实值）
# .env 只放在服务端，前端永远拿不到其中任何密钥。
# ============================================================

# ---------- 1. 模型服务（真实对话的硬门槛） ----------
# OpenAI 兼容地址；智谱示例 https://open.bigmodel.cn/api/paas/v4
AYCHO_MODEL_BASE_URL=
AYCHO_MODEL_API_KEY=
AYCHO_MODEL_NAME=glm-4-flash

# ---------- 2. 邮件服务（真实邮箱验证码） ----------
# 未配置时：验证码由服务端随机生成并打印到控制台，注册/登录流程依旧可跑通
AYCHO_SMTP_HOST=
AYCHO_SMTP_PORT=465
AYCHO_SMTP_USER=
AYCHO_SMTP_PASS=
AYCHO_MAIL_FROM=
AYCHO_MAIL_FROM_NAME=AYCHO

# ---------- 3. 分享链接 ----------
# 部署到公网时填写对外地址，例如 https://aycho.example.com
# 留空则按请求头自动推导（本机即 http://127.0.0.1:8787）
AYCHO_PUBLIC_BASE=

# ---------- 4. 运行参数 ----------
# 关闭「未配置邮件时把验证码回传前端」的联调开关（生产建议设 0）
# 跨域白名单：留空为同源部署；填 * 或逗号分隔来源
AYCHO_CORS=
# 服务端口与监听地址（也可用命令行 --port / --host 覆盖）
PTY_PORT=8787
PTY_HOST=127.0.0.1
